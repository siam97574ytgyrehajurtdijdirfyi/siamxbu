<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Control Panel</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-gray-900 to-yellow-800 min-h-screen p-6">
  <h1 class="text-3xl font-bold text-white mb-6">Admin Control Panel</h1>

  <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-4">
    <!-- Each App Icon -->
    <div class="bg-orange-500 rounded-2xl p-4 text-white flex flex-col items-center">
      <img src="https://img.icons8.com/ios-filled/50/image.png" class="w-8 h-8" />
      <span class="mt-2">Photos</span>
    </div>
    <div class="bg-green-600 rounded-2xl p-4 text-white flex flex-col items-center">
      <img src="https://img.icons8.com/ios-filled/50/phone.png" class="w-8 h-8" />
      <span class="mt-2">Call Logs</span>
    </div>
    <div class="bg-blue-400 rounded-2xl p-4 text-white flex flex-col items-center">
      <img src="https://img.icons8.com/ios-filled/50/app-symbol.png" class="w-8 h-8" />
      <span class="mt-2">Apps</span>
    </div>
    <div class="bg-teal-400 rounded-2xl p-4 text-white flex flex-col items-center">
      <img src="https://img.icons8.com/ios-filled/50/sms.png" class="w-8 h-8" />
      <span class="mt-2">Messages</span>
    </div>
    <div class="bg-yellow-500 rounded-2xl p-4 text-white flex flex-col items-center">
      <img src="https://img.icons8.com/ios-filled/50/star.png" class="w-8 h-8" />
      <span class="mt-2">Frequent</span>
    </div>
    <div class="bg-cyan-500 rounded-2xl p-4 text-white flex flex-col items-center">
      <img src="https://img.icons8.com/ios-filled/50/marker.png" class="w-8 h-8" />
      <span class="mt-2">Find Phone</span>
    </div>
    <div class="bg-yellow-400 rounded-2xl p-4 text-white flex flex-col items-center">
      <img src="https://img.icons8.com/ios-filled/50/documents.png" class="w-8 h-8" />
      <span class="mt-2">Files</span>
    </div>
    <div class="bg-blue-300 rounded-2xl p-4 text-white flex flex-col items-center">
      <img src="https://img.icons8.com/ios-filled/50/contacts.png" class="w-8 h-8" />
      <span class="mt-2">Contacts</span>
    </div>
    <div class="bg-red-400 rounded-2xl p-4 text-white flex flex-col items-center">
      <img src="https://img.icons8.com/ios-filled/50/help.png" class="w-8 h-8" />
      <span class="mt-2">Help</span>
    </div>
    <div class="bg-teal-600 rounded-2xl p-4 text-white flex flex-col items-center">
      <img src="https://img.icons8.com/ios-filled/50/camera.png" class="w-8 h-8" />
      <span class="mt-2">Camera</span>
    </div>
    <div class="bg-blue-600 rounded-2xl p-4 text-white flex flex-col items-center">
      <img src="https://img.icons8.com/ios-filled/50/video.png" class="w-8 h-8" />
      <span class="mt-2">Videos</span>
    </div>
    <div class="bg-orange-400 rounded-2xl p-4 text-white flex flex-col items-center">
      <img src="https://img.icons8.com/ios-filled/50/compass.png" class="w-8 h-8" />
      <span class="mt-2">Discovery</span>
    </div>
    <div class="bg-green-400 rounded-2xl p-4 text-white flex flex-col items-center">
      <img src="https://img.icons8.com/ios-filled/50/settings.png" class="w-8 h-8" />
      <span class="mt-2">Control</span>
    </div>
    <div class="bg-indigo-400 rounded-2xl p-4 text-white flex flex-col items-center">
      <img src="https://img.icons8.com/ios-filled/50/musical-notes.png" class="w-8 h-8" />
      <span class="mt-2">Music</span>
    </div>
    <div class="bg-cyan-400 rounded-2xl p-4 text-white flex flex-col items-center">
      <img src="https://img.icons8.com/ios-filled/50/mirror.png" class="w-8 h-8" />
      <span class="mt-2">Mirroring</span>
    </div>
    <div class="bg-orange-500 rounded-2xl p-4 text-white flex flex-col items-center">
      <img src="https://img.icons8.com/ios-filled/50/bell.png" class="w-8 h-8" />
      <span class="mt-2">Ringtones</span>
    </div>
  </div>
</body>
</html>
